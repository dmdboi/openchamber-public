{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "packages/mobile/android/app/src/main/assets/public/**",
    "packages/mobile/ios/App/App/public/**",
    "packages/sdk/examples/**",
  ],
  "workspaces": {
    ".": {
      "entry": [
        "oxlint.config.ts",
        "postcss.config.js",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/apps/renderVSCodeApp.tsx",
        "tests/**/*.bench.{ts,tsx}",
        "tests/**/*.{test,spec}.{js,cjs,mjs,jsx,ts,tsx}",
        "tests/**/__tests__/**/*.{js,cjs,mjs,jsx,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "packages/web": {
      "entry": [
        "src/mobile-main.tsx",
        "src/mini-chat-main.tsx",
        "src/main.tsx",
        "src/sw.ts",
        "tests/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "server/**/*.{js,mjs,cjs}",
        "src/**/*.{ts,tsx}",
        "tests/**/*.{js,mjs,cjs,ts,tsx}"
      ]
    },
    "packages/electron": {
      "entry": [
        "entry.mjs",
        "main.mjs",
        "preload.mjs",
        "tray.mjs",
        "ssh-manager.mjs",
        "opencode-cwd.mjs",
        "tests/**/*.{test,spec}.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ],
      "project": [
        "*.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}",
        "tests/**/*.{js,cjs,mjs}"
      ]
    },
    "packages/vscode": {
      "entry": [
        "webview/main.tsx",
        "tests/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "webview/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/ui/index.ts",
        "src/schemas.ts",
        "tests/**/*.{test,spec}.{js,ts}",
        "scripts/fixtures/guest-entry.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "tests/**/*.{js,ts}"
      ]
    },
    "packages/mobile": {
      "entry": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    }
  }
}
