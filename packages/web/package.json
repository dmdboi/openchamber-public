{
  "name": "@openchamber/web",
  "version": "2.1.1",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun ../../scripts/build-builtin-extensions.mjs && OPENCHAMBER_RELAY_HOST=${OPENCHAMBER_RELAY_HOST:-off} OPENCHAMBER_ALLOW_DEV_ORIGINS=1 bun --cwd ../api server/index.js --port ${OPENCHAMBER_PORT:-3001}",
    "dev:server:watch": "bun ../../scripts/build-builtin-extensions.mjs && node ../api/scripts/dev-server-watch.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./tests/**/*.{ts,tsx}\" --config ../../eslint.config.js",
    "test": "vitest run",
    "start": "bun run --cwd ../cli bin/cli.js serve"
  },
  "dependencies": {
    "@gitbeaker/rest": "43.8.0",
    "@octokit/rest": "^22.0.1",
    "@openchamber/sdk": "workspace:*",
    "@opencode/client": "2.0.23",
    "@opencode/schema": "2.0.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@eslint/js": "^9.33.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.7.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.3.0",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "strip-json-comments": "^5.0.3",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.4",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.8"
  },
  "files": [
    "dist",
    "public",
    "package.json",
    "README.md"
  ]
}
