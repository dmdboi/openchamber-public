{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "paths": {
      "@openchamber/contracts": ["../contracts/src/index.ts"],
      "@openchamber/contracts/git": ["../contracts/src/git.ts"]
    }
  },
  "include": ["src/**/*", "tests/src/**/*"],
  "exclude": ["node_modules", "dist", "webview"]
}
